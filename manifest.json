{
  "manifest_version": 3,
  "name": "Lexa — Vietnamese Trilingual Mastery",
  "version": "1.1",
  "description": "Capture YouTube subtitles and master Vietnamese through high-frequency drills.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "tts"
  ],
  "action": {},
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["extension/content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "index.html",
        "memory.html",
        "styles.css",
        "memory.js",
        "vault.js",
        "server/data/lr_1k.json",
        "server/data/lr_8k.json",
        "lib/force-graph.min.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
